        bool "ESP32-P4 WIFI6 LCD 4C tron 720x720"

    config LCD_CUSTOM
        bool "LCD tuy chinh (tu khai bao tham so man hinh)"
endchoice

choice DISPLAY_ESP32S3_KORVO2_V3
    depends on BOARD_TYPE_ESP_KORVO2_V3
    prompt "Loai LCD cho ESP32S3_KORVO2_V3"
    default ESP32S3_KORVO2_V3_LCD_ST7789
    help
        Kieu man hinh LCD

    config ESP32S3_KORVO2_V3_LCD_ST7789
        bool "ST7789 240x280"

    config ESP32S3_KORVO2_V3_LCD_ILI9341
        bool "ILI9341 240x320"
endchoice

choice DISPLAY_ESP32S3_AUDIO_BOARD
    depends on BOARD_TYPE_WAVESHARE_S3_AUDIO_BOARD
    prompt "Loai LCD cho ESP32S3_AUDIO_BOARD"
    default AUDIO_BOARD_LCD_JD9853
    help
        Kieu man hinh LCD

    config AUDIO_BOARD_LCD_JD9853
        bool "JD9853 320x172"

    config AUDIO_BOARD_LCD_ST7789
        bool "ST7789 240x320"
endchoice

choice DISPLAY_STYLE
    prompt "Chon kieu hien thi"
    default USE_DEFAULT_MESSAGE_STYLE
    help
        Chon kieu hien thi cho thiet bi Xiaozhi

    config USE_DEFAULT_MESSAGE_STYLE
        bool "Bat kieu hien thi mac dinh"

    config USE_WECHAT_MESSAGE_STYLE
        bool "Bat kieu hien thi dang chat (WeChat)"

    config USE_EMOTE_MESSAGE_STYLE
        bool "Kieu hien thi cam xuc (Emote animation)"
        depends on BOARD_TYPE_ESP_BOX_3 || BOARD_TYPE_ECHOEAR || BOARD_TYPE_LICHUANG_DEV_S3
endchoice

choice WAKE_WORD_TYPE
    prompt "Kieu thuc thi tu khoa danh thuc"
    default USE_AFE_WAKE_WORD if (IDF_TARGET_ESP32S3 || IDF_TARGET_ESP32P4) && SPIRAM
    default WAKE_WORD_DISABLED
    help
        Chon kieu cai dat tu khoa danh thuc (wake word)

    config WAKE_WORD_DISABLED
        bool "Tat"
        help
            Tat hoan toan tinh nang nhan dien tu khoa danh thuc

    config USE_ESP_WAKE_WORD
        bool "Mo hinh Wakenet (khong dung AFE)"
        depends on IDF_TARGET_ESP32C3 || IDF_TARGET_ESP32C5 || IDF_TARGET_ESP32C6 || (IDF_TARGET_ESP32 && SPIRAM)
        help
            Ho tro ESP32-C3, ESP32-C5, ESP32-C6 va ESP32 (co PSRAM)

    config USE_AFE_WAKE_WORD
        bool "Mo hinh Wakenet (kem AFE)"
        depends on (IDF_TARGET_ESP32S3 || IDF_TARGET_ESP32P4) && SPIRAM
        help
            Ho tro AEC neu co, yeu cau ESP32-S3 hoac ESP32-P4 va PSRAM

    config USE_CUSTOM_WAKE_WORD
        bool "Mo hinh Multinet (tu khoa danh thuc tuy chinh)"
        depends on (IDF_TARGET_ESP32S3 || IDF_TARGET_ESP32P4) && SPIRAM
        help
            Yeu cau ESP32-S3 hoac ESP32-P4 va PSRAM
endchoice

config CUSTOM_WAKE_WORD
    string "Tu khoa danh thuc tuy chinh"
    default "xiao tu dou"
    depends on USE_CUSTOM_WAKE_WORD
    help
        Tu khoa danh thuc tuy chinh, dung pinyin cho tieng Trung, cac tu cach nhau boi dau cach

config CUSTOM_WAKE_WORD_DISPLAY
    string "Chuoi hien thi khi danh thuc tuy chinh"
    default "Tieu Khoai Tay"
    depends on USE_CUSTOM_WAKE_WORD
    help
        Loi chao gui len may chu sau khi phat hien tu khoa danh thuc

config CUSTOM_WAKE_WORD_THRESHOLD
    int "Nguong tu khoa danh thuc tuy chinh (%)"
    default 20
    range 1 99
    depends on USE_CUSTOM_WAKE_WORD
    help
        Nguong kich hoat tu khoa danh thuc, trong khoang 1-99, gia tri cang nho thi cang nhay

config SEND_WAKE_WORD_DATA
    bool "Gui du lieu tu khoa danh thuc"
    default y
    depends on USE_AFE_WAKE_WORD || USE_CUSTOM_WAKE_WORD
    help
        Gui du lieu am thanh cua tu khoa danh thuc len may chu như thong diep dau tien va cho phan hoi

config USE_AUDIO_PROCESSOR
    bool "Bat xu ly tieng on am thanh"
    default y
    depends on (IDF_TARGET_ESP32S3 || IDF_TARGET_ESP32P4) && SPIRAM
    help
        Yeu cau ESP32-S3 hoac ESP32-P4 va PSRAM

config USE_DEVICE_AEC
    bool "Bat AEC tren thiet bi"
    default n
    depends on USE_AUDIO_PROCESSOR && (BOARD_TYPE_ESP_BOX_3 || BOARD_TYPE_ESP_BOX || BOARD_TYPE_ESP_BOX_LITE \
        || BOARD_TYPE_LICHUANG_DEV_S3 || BOARD_TYPE_ESP_KORVO2_V3 || BOARD_TYPE_WAVESHARE_S3_TOUCH_AMOLED_1_75 || BOARD_TYPE_WAVESHARE_S3_TOUCH_LCD_1_83 \
        || BOARD_TYPE_WAVESHARE_S3_TOUCH_AMOLED_2_06 || BOARD_TYPE_WAVESHARE_S3_TOUCH_LCD_4B || BOARD_TYPE_WAVESHARE_P4_WIFI6_TOUCH_LCD_4B || BOARD_TYPE_WAVESHARE_P4_WIFI6_TOUCH_LCD_7B \
        || BOARD_TYPE_WAVESHARE_P4_WIFI6_TOUCH_LCD_XC || BOARD_TYPE_ESP_S3_LCD_EV_Board_2 || BOARD_TYPE_YUNLIAO_S3 \
        || BOARD_TYPE_ECHOEAR || BOARD_TYPE_WAVESHARE_S3_TOUCH_LCD_3_49)
    help
        De hoat dong chinh xac, AEC chay tren thiet bi can duong tham chieu tin hieu loa sach
        va co cach ly am hoc tot giua micro va loa.

config USE_SERVER_AEC
    bool "Bat AEC phia may chu (khong on dinh)"
    default n
    depends on USE_AUDIO_PROCESSOR
    help
        De hoat dong chinh xac, AEC phia may chu can duoc ho tro tu phia server

config USE_AUDIO_DEBUGGER
    bool "Bat che do go loi am thanh"
    default n
    help
        Gui du lieu am thanh qua UDP den may tinh chu de go loi

config AUDIO_DEBUG_UDP_SERVER
    string "Dia chi UDP Server de go loi am thanh"
    default "192.168.2.100:8000"
    depends on USE_AUDIO_DEBUGGER
    help
        Dia chi UDP server, dinh dang IP:PORT, dung de nhan du lieu am thanh cho muc dich go loi

config USE_ACOUSTIC_WIFI_PROVISIONING
    bool "Bat cau hinh WiFi bang am thanh"
    default n
    help
        Truyen thong tin WiFi qua song am

config RECEIVE_CUSTOM_MESSAGE
    bool "Bat nhan thong diep tuy chinh"
    default n
    help
        Cho phep thiet bi nhan thong diep tuy chinh tu may chu (uu tien qua giao thuc MQTT)

menu "Cau hinh Camera"
    depends on !IDF_TARGET_ESP32

    comment "Canh bao: Hay doc ky phan tro giup truoc khi thay doi cac thiet lap nay."

    config XIAOZHI_ENABLE_HARDWARE_JPEG_ENCODER
        bool "Bat bo ma hoa JPEG bang phan cung"
        default y
        depends on SOC_JPEG_ENCODE_SUPPORTED
        help
            Su dung bo ma hoa JPEG phan cung de ma hoa anh sang JPEG.

    config XIAOZHI_ENABLE_CAMERA_DEBUG_MODE
        bool "Bat che do go loi camera"
        default n
        help
            In thong tin debug cua camera ra console.

    config XIAOZHI_ENABLE_CAMERA_ENDIANNESS_SWAP
        bool "Bat dao thu tu byte bo dem camera bang phan mem"
        default n
        depends on !CAMERA_SENSOR_SWAP_PIXEL_BYTE_ORDER
        help
            Tuy chon nay xem bo dem camera nhu mang uint16_t[] va dao thu tu byte cua tung phan tu.
            Chi nen thay doi boi ky su tich hop bo phat trien.

    menuconfig XIAOZHI_ENABLE_ROTATE_CAMERA_IMAGE
        bool "Bat xoay anh tu camera"
        default n
        help
            Bat xoay anh camera de hien thi dung chieu.

    if XIAOZHI_ENABLE_ROTATE_CAMERA_IMAGE
        choice XIAOZHI_CAMERA_IMAGE_ROTATION_ANGLE
            prompt "Goc xoay anh camera (theo chieu kim dong ho)"
            default XIAOZHI_CAMERA_IMAGE_ROTATION_ANGLE_90
            help
                Goc xoay anh camera.

            config XIAOZHI_CAMERA_IMAGE_ROTATION_ANGLE_90
                bool "90"

            config XIAOZHI_CAMERA_IMAGE_ROTATION_ANGLE_270
                bool "270"

            comment "Voi xoay 180, hay dung HFlip + VFlip thay vi tuy chon nay"
        endchoice
    endif
endmenu

menu "TAIJIPAI_S3_CONFIG"
    depends on BOARD_TYPE_TAIJI_PI_S3

    choice I2S_TYPE_TAIJIPI_S3
        prompt "Chon kieu I2S cho Taiji-Pi S3"
        default TAIJIPAI_I2S_TYPE_STD
        help
            Lua chon kieu I2S

        config TAIJIPAI_I2S_TYPE_STD
            bool "I2S kieu STD"

        config TAIJIPAI_I2S_TYPE_PDM
            bool "I2S kieu PDM"
    endchoice

    config I2S_USE_2SLOT
        bool "Bat I2S 2 kenh (2 Slot)"
        default y
        help
            Bat am thanh hai kenh (stereo)
endmenu

endmenu
