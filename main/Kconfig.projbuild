menu "Tro ly Xiaozhi"

config OTA_URL
    string "URL OTA mac dinh"
    default "https://api.tenclass.net/xiaozhi/ota/"
    help
        Ung dung se truy cap URL nay de kiem tra firmware moi va dia chi may chu.

choice
    prompt "Ghi (flash) goi tai nguyen"
    default FLASH_DEFAULT_ASSETS
    help
        Chon goi tai nguyen se duoc ghi (flash).

    config FLASH_NONE_ASSETS
        bool "Khong ghi (flash) goi tai nguyen"

    config FLASH_DEFAULT_ASSETS
        bool "Ghi (flash) goi tai nguyen mac dinh"

    config FLASH_CUSTOM_ASSETS
        bool "Ghi (flash) goi tai nguyen tuy chinh"
endchoice

config CUSTOM_ASSETS_FILE
    depends on FLASH_CUSTOM_ASSETS
    string "Tep goi tai nguyen tuy chinh"
    default "assets.bin"
    help
        Tep goi tai nguyen tuy chinh de ghi (flash).
        Co the la tep cuc bo tuong doi voi thu muc du an hoac mot URL tu xa.

